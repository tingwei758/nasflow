# Copy to .env next to docker-compose.yml and adjust.

# The folder that contains BOTH qBittorrent's downloads and flow's staging tree.
# It is mounted once, at this same path inside the container.
FLOW_QB_ROOT=/volume1/docker/qb

# Holds config.toml and flow.db.
FLOW_CONFIG_DIR=/volume1/docker/flow

# The NAS's LAN address. The board is published on this interface only.
FLOW_LAN_IP=192.168.4.126
FLOW_PORT=8080

# Owner of qBittorrent's files.
FLOW_PUID=911
FLOW_PGID=911
