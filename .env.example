# Copy to .env next to docker-compose.yml and adjust.

# The folder that contains BOTH qBittorrent's downloads and nasflow's staging tree.
# It is mounted once, at this same path inside the container.
NASFLOW_QB_ROOT=/volume1/docker/qb

# Holds config.toml and nasflow.db.
NASFLOW_CONFIG_DIR=/volume1/docker/nasflow

# The NAS's LAN address. The board is published on this interface only.
NASFLOW_LAN_IP=192.168.4.126
NASFLOW_PORT=9987

# Owner of qBittorrent's files.
NASFLOW_PUID=911
NASFLOW_PGID=911
